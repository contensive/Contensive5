# Required — the base URL of the staging site to test against
STAGING_URL=https://staging.example.com

# Required — credentials for an admin account on the staging site
TEST_USERNAME=
TEST_PASSWORD=

# Required for admin tests — GUID of a content definition to test list/edit views
# (e.g., the People content GUID from your Contensive installation)
TEST_CONTENT_GUID=

# Optional — set to "true" to enable CI behavior (retries, forbid .only())
# CI=true
