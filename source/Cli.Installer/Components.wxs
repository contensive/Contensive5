<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Fragment>
    
    <!-- Product Components -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- reference the components to install -->
      <ComponentRef Id="MainAppShortcut"/>
      <ComponentRef Id="ReadmeFile"/>
      <ComponentRef Id="TaskServiceComponent"/>
    </ComponentGroup>
    
    <!-- reference the directory in the directories file -->
    <DirectoryRef Id="INSTALLFOLDER" FileSource="..\Cli\bin\Debug\net48\">
      
      <!-- Shortcut to main application-->
      <Component Id="MainAppShortcut" Guid="{79E3B767-5C45-40D6-A0BC-6DDE1B0E4257}">
        
        <!-- add install path to environment path variable-->
        <Environment
          Id="PATH"
          Name="PATH"
          Value="[INSTALLDIR]"
          Permanent="yes"
          Part="last"
          Action="set"
          System="yes" />        
        
        <!-- add a shortcut (not really needed) -->
        <Shortcut
          Id="MainAppShortcut"
          Name="Contensive Console"
          Target="[INSTALLFOLDER]cc.exe"
          Directory="InstallProgramMenuFolder"
          WorkingDirectory="INSTALLFOLDER"
          Icon="icon.ico"
          />
        
        <!-- shortcut cannot have a key, and a key is needed, so add a registry entry to get the key -->
        <RegistryValue 
          Id="RegShortcutKey" 
          Name="Shortcut" 
          Root="HKCU" 
          Key="SOFTWARE\!(loc.ProductNameFolder)"
          Value="1"
          Type="integer"
          KeyPath="yes"          
          />

         <!--Remove Start Menu Items on uninstal-->
        <RemoveFolder Id="RemoveStartFolder" Directory="InstallProgramMenuFolder" On="uninstall"/>

      </Component>

      <!-- README.txt file -->
      <Component Id="ReadmeFile" Guid="{B8F4E2A3-7C6D-4E9B-A5F1-2D3C4E5F6A7B}">
        <File
          Id="ReadmeFile"
          Name="README.txt"
          Source="..\..\docs\README.txt"
          Vital="yes"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Task Service Windows Service.
         The exe is declared here with ServiceInstall/ServiceControl.
         The XSL transform in the HeatDirectory step excludes the exe from the
         auto-harvested componentsGenerated.wxs to avoid duplicate file errors. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="TaskServiceComponent" Guid="{D4E5F6A7-B8C9-0123-DEF0-123456789ABC}">
        <File
          Id="TaskServiceExe"
          Name="TaskService.exe"
          Source="$(var.BasePath)\TaskService.exe"
          Vital="yes"
          KeyPath="yes" />

        <ServiceInstall
          Id="TaskServiceInstaller"
          Type="ownProcess"
          Vital="yes"
          Name="TaskService"
          DisplayName="Contensive Task Service"
          Description="Manages Task Scheduler and Task Runner activities"
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Interactive="no" />

        <ServiceControl
          Id="TaskServiceControl"
          Stop="both"
          Start="install"
          Remove="uninstall"
          Name="TaskService"
          Wait="yes" />
      </Component>
    </DirectoryRef>

  </Fragment>
</Wix>
