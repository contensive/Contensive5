<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Fragment>
    
    <!-- Product Components -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- reference the components to install -->
      <ComponentRef Id="MainAppShortcut"/>
      <ComponentRef Id="ReadmeFile"/>
      <ComponentRef Id="McpServerService"/>
      <ComponentRef Id="McpServerConfig"/>
    </ComponentGroup>
    
    <!-- reference the directory in the directories file -->
    <DirectoryRef Id="INSTALLFOLDER" FileSource="..\Cli\bin\Debug\net48\">
      
      <!-- Shortcut to main application-->
      <Component Id="MainAppShortcut" Guid="{79E3B767-5C45-40D6-A0BC-6DDE1B0E4257}">
        
        <!-- add install path to environment path variable-->
        <Environment
          Id="PATH"
          Name="PATH"
          Value="[INSTALLDIR]"
          Permanent="yes"
          Part="last"
          Action="set"
          System="yes" />        
        
        <!-- add a shortcut (not really needed) -->
        <Shortcut
          Id="MainAppShortcut"
          Name="Contensive Console"
          Target="[INSTALLFOLDER]cc.exe"
          Directory="InstallProgramMenuFolder"
          WorkingDirectory="INSTALLFOLDER"
          Icon="icon.ico"
          />
        
        <!-- shortcut cannot have a key, and a key is needed, so add a registry entry to get the key -->
        <RegistryValue 
          Id="RegShortcutKey" 
          Name="Shortcut" 
          Root="HKCU" 
          Key="SOFTWARE\!(loc.ProductNameFolder)"
          Value="1"
          Type="integer"
          KeyPath="yes"          
          />

         <!--Remove Start Menu Items on uninstal-->
        <RemoveFolder Id="RemoveStartFolder" Directory="InstallProgramMenuFolder" On="uninstall"/>

      </Component>

      <!-- README.txt file -->
      <Component Id="ReadmeFile" Guid="{B8F4E2A3-7C6D-4E9B-A5F1-2D3C4E5F6A7B}">
        <File
          Id="ReadmeFile"
          Name="README.txt"
          Source="..\..\docs\README.txt"
          Vital="yes"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- MCP Server Windows Service.
         The exe is declared here with ServiceInstall/ServiceControl.
         The XSL transform in the HeatDirectory step excludes the exe from the
         auto-harvested componentsMcpGenerated.wxs to avoid duplicate file errors.
         All other runtime DLLs are harvested automatically. -->
    <DirectoryRef Id="MCPSERVERFOLDER">
      <Component Id="McpServerService" Guid="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}">
        <File
          Id="McpServerExe"
          Name="ContensiveMcpServer.exe"
          Source="$(var.McpBasePath)\ContensiveMcpServer.exe"
          Vital="yes"
          KeyPath="yes" />

        <ServiceInstall
          Id="McpServiceInstaller"
          Type="ownProcess"
          Vital="yes"
          Name="ContensiveMcpServer"
          DisplayName="Contensive MCP Server"
          Description="Contensive Model Context Protocol server for AI-assisted content management"
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Interactive="no" />

        <ServiceControl
          Id="McpServiceControl"
          Stop="both"
          Start="install"
          Remove="uninstall"
          Name="ContensiveMcpServer"
          Wait="yes" />
      </Component>

      <!-- MCP Server configuration file.
           NeverOverwrite="yes" preserves user edits across upgrades and reinstalls.
           Permanent="yes" leaves the file on disk after uninstall so a reinstall
           picks up the existing configuration. -->
      <Component Id="McpServerConfig" Guid="{B2C3D4E5-F6A7-8901-BCDE-F23456789012}" NeverOverwrite="yes" Permanent="yes">
        <File
          Id="McpServerAppSettings"
          Name="appsettings.json"
          Source="$(var.McpBasePath)\appsettings.json"
          Vital="yes"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
