<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>hello_aspnet</RootNamespace>
		<StartupObject></StartupObject>
		<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
		<NoWarn>1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="AWSSDK.CloudWatchLogs" Version="3.7.501.7" />
	  <PackageReference Include="AWSSDK.Core" Version="3.7.500.27" />
	  <PackageReference Include="AWSSDK.IdentityManagement" Version="3.7.501.19" />
	  <PackageReference Include="AWSSDK.S3" Version="3.7.501.12" />
	  <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.501.18" />
	  <PackageReference Include="SixLabors.ImageSharp" Version="2.1.12" />
	  <PackageReference Include="System.Net.Http" Version="4.3.4" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\CPBase\CPBase.csproj" />
	  <ProjectReference Include="..\Models\Models.csproj" />
	  <ProjectReference Include="..\Processor\Processor.csproj" />
	</ItemGroup>


	<Target Name="CopyBaseAssets" BeforeTargets="Build;Publish">
		<ItemGroup>
			<BaseAssetFiles Include="$(ProjectDir)..\..\ui\baseassets\BaseAssets\**\*" />
		</ItemGroup>
		<MakeDir Directories="$(ProjectDir)webroot\baseassets\" />
		<Copy SourceFiles="@(BaseAssetFiles)" DestinationFiles="@(BaseAssetFiles->'$(ProjectDir)webroot\baseassets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

</Project>
