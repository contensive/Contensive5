<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="Collection">
		<xs:annotation><xs:documentation>Root element defining a Contensive addon collection package. Contains content definitions, addons, navigator entries, SQL indexes, data records, dependency imports, and resource files.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element name="CDef" minOccurs="1" maxOccurs="unbounded">
						<xs:annotation><xs:documentation>Content Definition. Defines a database table and its fields, controlling how the admin site displays and manages that content. Maps to the ccContent metadata table.</xs:documentation></xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:choice minOccurs="0" maxOccurs="unbounded">
									<xs:element name="Field"  minOccurs="1" maxOccurs="unbounded">
										<xs:annotation><xs:documentation>Defines a database column within a content definition and its admin editor behavior.</xs:documentation></xs:annotation>
										<xs:complexType>
											<xs:choice minOccurs="0" maxOccurs="unbounded">
												<xs:element ref="HelpDefault" />
											</xs:choice>
											<xs:attribute name="active" type="xs:boolean">
												<xs:annotation><xs:documentation>When false, the field is disabled.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="adminOnly" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, field is visible only to admin users.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="authorable" type="xs:boolean">
												<xs:annotation><xs:documentation>When false, field is hidden from the edit form.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="caption" type="xs:string" use="required">
												<xs:annotation><xs:documentation>Display label shown in the admin edit form.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="defaultValue" type="xs:string">
												<xs:annotation><xs:documentation>Initial value assigned to this field for new records.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="developerOnly" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, field is visible only to developer users.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="editSortPriority" type="xs:integer">
												<xs:annotation><xs:documentation>Order of appearance on the edit form. Lower values appear first.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="editorAddonId" type="xs:string">
												<xs:annotation><xs:documentation>GUID of a custom editor addon for this field.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="editTab" type="xs:string">
												<xs:annotation><xs:documentation>Tab name on the edit form (e.g., "Features", "Presentation", "Control Info").</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="editGroup" type="xs:string">
												<xs:annotation><xs:documentation>Group name for organizing fields within an edit tab.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="fieldType" use="required">
												<xs:annotation><xs:documentation>Data type of the field. Determines storage format and editor control.</xs:documentation></xs:annotation>
												<xs:simpleType>
													<xs:restriction base="xs:NMTOKEN">
														<xs:enumeration value="boolean">
															<xs:annotation><xs:documentation>Checkbox input (true/false).</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="cssFile">
															<xs:annotation><xs:documentation>CSS file stored on the filesystem.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="currency">
															<xs:annotation><xs:documentation>Currency value with decimal precision.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="date">
															<xs:annotation><xs:documentation>Date picker input.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="file">
															<xs:annotation><xs:documentation>General file upload.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="float">
															<xs:annotation><xs:documentation>Decimal number input.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="html">
															<xs:annotation><xs:documentation>Rich HTML editor (WYSIWYG). Set htmlContent=true for raw HTML mode.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="htmlCode">
															<xs:annotation><xs:documentation>Raw HTML code editor without WYSIWYG.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="htmlCodeFile">
															<xs:annotation><xs:documentation>HTML code stored in a file on the filesystem.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="htmlFile">
															<xs:annotation><xs:documentation>HTML content stored in a file on the filesystem.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="image">
															<xs:annotation><xs:documentation>Image file upload with preview.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="integer">
															<xs:annotation><xs:documentation>Whole number input.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="javaScriptFile">
															<xs:annotation><xs:documentation>JavaScript file stored on the filesystem.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="link">
															<xs:annotation><xs:documentation>URL input field.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="longText">
															<xs:annotation><xs:documentation>Multi-line text area.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="lookup">
															<xs:annotation><xs:documentation>Dropdown select referencing another content definition. Set lookupContent to the target CDef name.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="lookupList">
															<xs:annotation><xs:documentation>Dropdown select from a static pipe-separated list. Set lookupList attribute.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="manyToMany">
															<xs:annotation><xs:documentation>Many-to-many relationship via a rule table. Set manyToManyContent, manyToManyRuleContent, manyToManyRulePrimaryField, and manyToManyRuleSecondaryField.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="memberSelect">
															<xs:annotation><xs:documentation>Member/user select dropdown filtered by security group.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="redirect">
															<xs:annotation><xs:documentation>Displays related records from another content. Set redirectContent and redirectId.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="resourceLink">
															<xs:annotation><xs:documentation>Link to a resource file in the collection.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="text">
															<xs:annotation><xs:documentation>Single-line text input.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="textFile">
															<xs:annotation><xs:documentation>Text content stored in a file on the filesystem.</xs:documentation></xs:annotation>
														</xs:enumeration>
														<xs:enumeration value="xmlFile">
															<xs:annotation><xs:documentation>XML content stored in a file on the filesystem.</xs:documentation></xs:annotation>
														</xs:enumeration>
													</xs:restriction>
												</xs:simpleType>
											</xs:attribute>
											<xs:attribute name="htmlContent" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, enables raw HTML editing for HTML-type fields.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="indexColumn" type="xs:string">
												<xs:annotation><xs:documentation>Column position in admin listing (0-based). 99 = hidden from listing.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="indexSortDirection" type="xs:string">
												<xs:annotation><xs:documentation>Sort direction in admin listing. 0 = ascending, 1 = descending.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="indexSortOrder" type="xs:string">
												<xs:annotation><xs:documentation>Sort priority in admin listing. Lower values sort first.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="indexWidth" type="xs:string">
												<xs:annotation><xs:documentation>Relative width of column in admin listing. 0 = hidden.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="isBaseField" type="xs:boolean">
												<xs:annotation><xs:documentation>True for base fields provided by the framework (Name, Active, etc.).</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="lookupContent" type="xs:string">
												<xs:annotation><xs:documentation>CDef name for dynamic lookup dropdowns. Used with fieldType="lookup".</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="lookupList" type="xs:string">
												<xs:annotation><xs:documentation>Pipe-separated static lookup values (e.g., "Option1|Option2"). Used with fieldType="lookupList".</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="manyToManyContent" type="xs:string">
												<xs:annotation><xs:documentation>CDef name of the target content for many-to-many relationships.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="manyToManyRuleContent" type="xs:string">
												<xs:annotation><xs:documentation>CDef name of the rule (join) table for many-to-many relationships.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="manyToManyRulePrimaryField" type="xs:string">
												<xs:annotation><xs:documentation>Field name in the rule table referencing this content's record ID.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="manyToManyRuleSecondaryField" type="xs:string">
												<xs:annotation><xs:documentation>Field name in the rule table referencing the target content's record ID.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="memberSelectGroup" type="xs:string">
												<xs:annotation><xs:documentation>Security group name for member select fields.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="memberSelectGroupId" type="xs:string">
												<xs:annotation><xs:documentation>Security group ID for member select fields.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="name" type="xs:string" use="required">
												<xs:annotation><xs:documentation>Database column name.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="notEditable" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, field is write-once -- editable only when adding a new record.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="password" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, renders as a password input masking the value.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="readOnly" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, field is never editable in the admin UI.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="redirectContent" type="xs:string">
												<xs:annotation><xs:documentation>CDef name for redirect-type fields, showing related records from this content.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="redirectPath" type="xs:string">
												<xs:annotation><xs:documentation>URL path for redirect-type fields.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="required" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, field cannot be left blank.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="redirectId" type="xs:string">
												<xs:annotation><xs:documentation>Record ID for redirect-type fields.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="rssTitleField" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, this field is used as the RSS feed title.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="rssDescriptionField" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, this field is used as the RSS feed description.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="rssTitle" type="xs:string">
												<xs:annotation><xs:documentation>Static RSS title override for this field.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="rssDescription" type="xs:string">
												<xs:annotation><xs:documentation>Static RSS description override for this field.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="scramble" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, value is scrambled (obfuscated) in the database.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="textBuffered" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, enables text buffering for this field.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="uniqueName" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, value must be unique across all records in this content.</xs:documentation></xs:annotation>
											</xs:attribute>
											<xs:attribute name="deprecated" type="xs:boolean">
												<xs:annotation><xs:documentation>When true, the field is marked as deprecated. If the field does not exist, it will not be installed. If the field exists, its ccFields metadata record will be deleted while preserving the SQL database column and data.</xs:documentation></xs:annotation>
											</xs:attribute>
										</xs:complexType>
									</xs:element>
								</xs:choice>
							</xs:sequence>
							<xs:attribute name="name" type="xs:string">
								<xs:annotation><xs:documentation>Content definition name, used in API calls like cp.Content.GetTable().</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="addonCategoryId" type="xs:string">
								<xs:annotation><xs:documentation>Category for admin navigation grouping.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="activeOnly" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, only active records are shown in admin listings.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="adminOnly" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, restricts visibility to admin users only.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="aliasId" type="xs:string">
								<xs:annotation><xs:documentation>Field name used as the record ID alias (typically "id").</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="aliasName" type="xs:string">
								<xs:annotation><xs:documentation>Field name used as the record name alias (typically "name").</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="allowAdd" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, allows adding new records in the admin UI.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="allowContentChildTool" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, enables the content child tool for this content.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="allowContentTracking" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, enables content tracking for audit purposes.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="allowDelete" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, allows deleting records in the admin UI.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="allowTopicRules" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, allows topic rule associations.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="allowWorkflowAuthoring" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, enables workflow authoring for this content.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="authoringDataSourceName" type="xs:string">
								<xs:annotation><xs:documentation>Data source name for authoring (typically "DEFAULT").</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="authoringTableName" type="xs:string">
								<xs:annotation><xs:documentation>Database table name for authoring, usually same as contentTableName.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="contentDataSourceName" type="xs:string">
								<xs:annotation><xs:documentation>Data source name for content access (typically "DEFAULT").</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="contentTableName" type="xs:string">
								<xs:annotation><xs:documentation>Physical database table name (e.g., ccMembers, myCustomTable).</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="defaultSortMethod" type="xs:string">
								<xs:annotation><xs:documentation>Default listing sort method (e.g., "By Name", "By Date", "By Alpha Sort Order Field").</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="developerOnly" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, restricts visibility to developer users only.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="dropDownFieldList" type="xs:string">
								<xs:annotation><xs:documentation>Field name(s) shown in dropdown selectors (e.g., "NAME").</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="editorGroupName" type="xs:string">
								<xs:annotation><xs:documentation>Security group name with editing permissions for this content.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="parent" type="xs:string">
								<xs:annotation><xs:documentation>Name of parent CDef for content inheritance.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="navIconType">
								<xs:annotation><xs:documentation>Admin navigator icon category.</xs:documentation></xs:annotation>
								<xs:simpleType>
									<xs:union>
										<xs:simpleType>
											<xs:restriction base='xs:string'>
											<xs:length value="0"/>
											</xs:restriction>
										</xs:simpleType>
										<xs:simpleType>
											<xs:restriction base="xs:NMTOKEN">
												<xs:enumeration value="content">
													<xs:annotation><xs:documentation>Content management section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												<xs:enumeration value="report">
													<xs:annotation><xs:documentation>Reporting section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												</xs:restriction>
										</xs:simpleType>
									</xs:union>
								</xs:simpleType>
							</xs:attribute>
							<xs:attribute name="iconLink" type="xs:string">
								<xs:annotation><xs:documentation>URL path to a custom navigator icon image.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="iconWidth" type="xs:string">
								<xs:annotation><xs:documentation>Width in pixels of the custom navigator icon.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="iconHeight" type="xs:string">
								<xs:annotation><xs:documentation>Height in pixels of the custom navigator icon.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="iconSprites" type="xs:string">
								<xs:annotation><xs:documentation>Number of sprite frames in the custom navigator icon.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="guid" use="required">
								<xs:annotation><xs:documentation>Unique identifier for this content definition. Brace-wrapped GUID format.</xs:documentation></xs:annotation>
								<xs:simpleType>
									<xs:restriction base ="GUID"/>
							   </xs:simpleType>
							</xs:attribute>
							<xs:attribute name="active" type="xs:boolean">
								<xs:annotation><xs:documentation>When false, this content definition is disabled.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="navTypeId">
								<xs:annotation><xs:documentation>Admin navigator section where this content appears.</xs:documentation></xs:annotation>
								<xs:simpleType>
									<xs:union>
										<xs:simpleType>
											<xs:restriction base='xs:string'>
											  <xs:length value="0"/>
											</xs:restriction>
										</xs:simpleType>
										<xs:simpleType>
											<xs:restriction base="xs:NMTOKEN">
												<xs:enumeration value="Comm">
													<xs:annotation><xs:documentation>Communications section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												<xs:enumeration value="Content">
													<xs:annotation><xs:documentation>Content management section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												<xs:enumeration value="Design">
													<xs:annotation><xs:documentation>Design and layout section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												<xs:enumeration value="Report">
													<xs:annotation><xs:documentation>Reporting section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												<xs:enumeration value="Setting">
													<xs:annotation><xs:documentation>Settings and configuration section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												<xs:enumeration value="System">
													<xs:annotation><xs:documentation>System administration section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												<xs:enumeration value="Tool">
													<xs:annotation><xs:documentation>Tools section.</xs:documentation></xs:annotation>
												</xs:enumeration>
												<xs:enumeration value="Profile">
													<xs:annotation><xs:documentation>User profile section.</xs:documentation></xs:annotation>
												</xs:enumeration>
											</xs:restriction>
										</xs:simpleType>
									</xs:union>
								</xs:simpleType>
							</xs:attribute>
							<xs:attribute name="allowCalendarEvents" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, allows calendar event associations for records.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="allowMetaContent" type="xs:string">
								<xs:annotation><xs:documentation>When true, enables meta content fields for SEO.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="isBaseContent" type="xs:string">
								<xs:annotation><xs:documentation>Marks this as a base content definition provided by the framework.</xs:documentation></xs:annotation>
							</xs:attribute>
							<xs:attribute name="ignoreContentControl" type="xs:boolean">
								<xs:annotation><xs:documentation>When true, bypasses content control security checks.</xs:documentation></xs:annotation>
							</xs:attribute>
						</xs:complexType>
					</xs:element>
					<xs:element name="Addon" minOccurs="1" maxOccurs="unbounded" >
						<xs:annotation><xs:documentation>Registers an executable addon with the system. Addons are the primary unit of functionality in Contensive.</xs:documentation></xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:choice minOccurs="0" maxOccurs="unbounded">
									<xs:element minOccurs="0" maxOccurs="1" name="Admin" type="xs:string">
										<xs:annotation><xs:documentation>Yes = addon is available in admin tools section.</xs:documentation></xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" maxOccurs="1" name="DotNetClass" type="xs:string">
										<xs:annotation><xs:documentation>Fully qualified .NET class name (namespace.classname) implementing AddonBaseClass.</xs:documentation></xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" maxOccurs="1" name="RemoteMethod"  type="booleanYesNo">
										<xs:annotation><xs:documentation>Yes = addon is callable as an HTTP API endpoint.</xs:documentation></xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" maxOccurs="1" name="DashboardWidget"  type="booleanYesNo">
										<xs:annotation><xs:documentation>Yes = addon appears as a dashboard widget.</xs:documentation></xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" maxOccurs="1" name="FormXml" type="xs:string">
										<xs:annotation><xs:documentation>XML definition of a settings form for type="setting" addons.</xs:documentation></xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" maxOccurs="1" name="ProcessInterval"  type="xs:integer">
										<xs:annotation><xs:documentation>Minutes between background task executions. Used with type="task" addons.</xs:documentation></xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" maxOccurs="1" name="BlockEditTools"  type="booleanYesNo">
										<xs:annotation><xs:documentation>Yes = suppresses the editing toolbar when this addon executes.</xs:documentation></xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" maxOccurs="1" name="StylesLinkHref"  type="xs:string">
