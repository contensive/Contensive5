# ==============================================================================
# Contensive e2e settings file  (secrets: placeholders only in the repo copy)
#
# This file is NOT in git. Keep it here:  %LOCALAPPDATA%\contensive\e2e.env
#   (usually C:\Users\<you>\AppData\Local\contensive\e2e.env)
# It is outside every repo on purpose, so a password can never be committed.
#
# Full instructions (where each value comes from, how to check, what to do when
# a password changes):
#   C:\Git\Contensive5\docs\e2e-setup.md
#   https://github.com/contensive/Contensive5/blob/main/docs/e2e-setup.md
#
# Check this file at any time (never prints values):
#   .\release-runner.ps1 -CheckE2E          (in C:\Git\Contensive5\scripts\release)
#   npm run e2e:check                       (in C:\Git\aoEcommerce\tests\e2e)
#
# Format: KEY=VALUE, one per line. No quotes needed. Lines starting with # are comments.
# A value that is empty, looks like <something>, or is "changeme" counts as NOT SET.
#
# Keep in sync: this text is also embedded in
#   aoEcommerce tests/e2e/scripts/e2e-setup.mjs
# Change both together.
# ==============================================================================

# Test site the suite runs against. REQUIRED. Must be https and an allowed host.
E2E_BASE_URL=https://test.sitefpo.com

# Dedicated e2e admin account on the test site (admin rights). REQUIRED.
# If it is lost: in test.sitefpo.com admin > People, create a new user "e2e-admin" with developer/admin rights.
E2E_ADMIN_USER=<required: e2e admin username>
E2E_ADMIN_PASSWORD=<required: e2e admin password>

# Password given to the TEST-E2E customers the suite creates. REQUIRED.
# Make up any new password. You never type it anywhere else.
E2E_CUSTOMER_PASSWORD=<required: any new password>

# Bearer token for https://test.sitefpo.com/installCollection. REQUIRED on the release machine only
# (the machine that runs release-runner.ps1). Not needed for the suite alone or in the cloud.
# It is the same token the interactive deploy (build-deploy-remote.cmd) asks for. A long-lived one is preferred.
CONTENSIVE_TEST_TOKEN=<required on the release machine: deploy bearer token>

# ---- optional: remove the leading # and fill in to use ----

# Mailbox that receives the ecommerce emails the suite triggers (a mailbox Jay reads).
# Default if unset: e2e-redirect@example.com
# E2E_TEST_EMAIL_TO=you@example.com

# Hosts the suite may run against, comma separated. Default if unset: test.sitefpo.com
# E2E_ALLOWED_HOSTS=test.sitefpo.com

# Gateway sandbox keys. The @gateway tests skip when these are not set. SANDBOX / TEST-MODE keys only.
# Authorize.Net sandbox: developer.authorize.net > Sandbox account > API Credentials & Keys
# E2E_AUTHNET_LOGIN_ID=
# E2E_AUTHNET_TRANSACTION_KEY=
# Stripe test mode: dashboard.stripe.com (test mode on) > Developers > API keys (sk_test_...), and the webhook signing secret (whsec_...)
# E2E_STRIPE_SECRET_KEY=
# E2E_STRIPE_WEBHOOK_SECRET=
